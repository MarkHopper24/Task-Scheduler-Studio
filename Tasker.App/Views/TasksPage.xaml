<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Tasker_App.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:core="using:Tasker.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Tasker_App.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Tasker_App.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FolderColumn" Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Folder tree  -->
        <Grid
            x:Name="FolderPane"
            Grid.Column="0"
            Padding="12,12,6,12"
            RowSpacing="8"
            Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.IsFolderPaneOpen), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="8,4" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Folders"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Button
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="NewFolderButton"
                    AutomationProperties.Name="New folder"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="NewFolder_Click"
                    ToolTipService.ToolTip="New folder">
                    <FontIcon FontSize="14" Glyph="&#xE8F4;" />
                </Button>
                <Button
                    Grid.Column="2"
                    Width="32"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="DeleteFolderButton"
                    AutomationProperties.Name="Delete selected folder"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="DeleteFolder_Click"
                    ToolTipService.ToolTip="Delete selected folder (must be empty)">
                    <FontIcon FontSize="14" Glyph="&#xED62;" />
                </Button>
                <Button
                    Grid.Column="3"
                    Width="32"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="CollapseFoldersButton"
                    AutomationProperties.Name="Hide folder pane"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ToggleFolderPaneCommand}"
                    ToolTipService.ToolTip="Hide folder pane">
                    <FontIcon FontSize="14" Glyph="&#xE8A0;" />
                </Button>
            </Grid>
            <TreeView
                x:Name="FolderTree"
                Grid.Row="1"
                AutomationProperties.AutomationId="FolderTree"
                ItemInvoked="FolderTree_ItemInvoked"
                ItemsSource="{x:Bind ViewModel.Folders}"
                RightTapped="FolderTree_RightTapped"
                SelectionMode="Single">
                <TreeView.ContextFlyout>
                    <MenuFlyout x:Name="FolderContextMenu">
                        <MenuFlyoutItem Click="GuidedSetup_Click" Text="New task here&#x2026;">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE710;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="NewFolder_Click" Text="New folder&#x2026;">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8F4;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="Backup_Click" Text="Back up this folder&#x2026;">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEDE1;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="Restore_Click" Text="Restore from backup&#x2026;">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8E5;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Command="{x:Bind ViewModel.RefreshCommand}" Text="Refresh">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72C;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="DeleteFolder_Click" Text="Delete folder">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </TreeView.ContextFlyout>
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FolderNode">
                        <TreeViewItem
                            AutomationProperties.Name="{x:Bind Name}"
                            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                            ItemsSource="{x:Bind Children}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="16" Glyph="{x:Bind Glyph}" />
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind TaskCount}"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <!--  Main content  -->
        <Grid Grid.Column="1" Padding="18,12,18,18" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="TableRow" Height="*" MinHeight="120" />
                <RowDefinition x:Name="SplitterRow" Height="Auto" />
                <RowDefinition x:Name="DetailRow" Height="0" />
            </Grid.RowDefinitions>

            <!--  Toolbar  -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Width="36"
                    Height="36"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="ShowFoldersButton"
                    Command="{x:Bind ViewModel.ToggleFolderPaneCommand}"
                    ToolTipService.ToolTip="Show folder pane"
                    Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.IsFolderPaneCollapsed), Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xE8A0;" />
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Scheduled Tasks" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.CurrentFolderPath, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>

                <AutoSuggestBox
                    Grid.Column="2"
                    MaxWidth="360"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="TaskSearchBox"
                    PlaceholderText="Search tasks, actions, triggers&#x2026;"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel
                    Grid.Column="3"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <DropDownButton AutomationProperties.AutomationId="NewTaskButton" Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="New task" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem AutomationProperties.AutomationId="GuidedSetup" Click="GuidedSetup_Click" Text="Guided setup (recommended)">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8FD;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem AutomationProperties.AutomationId="DesignVisually" Click="DesignVisually_Click" Text="Design visually">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE9D9;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem AutomationProperties.AutomationId="NewBlankTask" Click="NewTask_Click" Text="Blank task">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7C3;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="Template_Click" Tag="0" Text="Run a program daily" />
                                <MenuFlyoutItem Click="Template_Click" Tag="1" Text="Run at log on" />
                                <MenuFlyoutItem Click="Template_Click" Tag="2" Text="Run at startup" />
                                <MenuFlyoutItem Click="Template_Click" Tag="3" Text="Run a PowerShell script weekly" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button AutomationProperties.AutomationId="ImportButton" AutomationProperties.Name="Import task from XML" Click="Import_Click" ToolTipService.ToolTip="Import task from XML">
                        <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                    </Button>
                    <Button AutomationProperties.AutomationId="RefreshButton" AutomationProperties.Name="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Refresh">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                    <Button AutomationProperties.AutomationId="MoreButton" AutomationProperties.Name="More" ToolTipService.ToolTip="More">
                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem AutomationProperties.AutomationId="BackupButton" Click="Backup_Click" Text="Back up this folder&#x2026;">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEDE1;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem AutomationProperties.AutomationId="RestoreButton" Click="Restore_Click" Text="Restore from backup&#x2026;">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8E5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.IsNotElevated), Mode=OneWay}" />
                                <MenuFlyoutItem
                                    AutomationProperties.AutomationId="RestartAdminButton"
                                    Click="RestartAdmin_Click"
                                    Text="Restart as administrator"
                                    Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.IsNotElevated), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7EF;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    Grid.Column="0"
                    AutomationProperties.AutomationId="IncludeSubfoldersCheck"
                    Content="Include subfolders"
                    IsChecked="{x:Bind ViewModel.IncludeSubfolders, Mode=TwoWay}" />
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.HasMultiSelection), Mode=OneWay}">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}" />
                    <Button AutomationProperties.AutomationId="BulkRunButton" Command="{x:Bind ViewModel.RunSelectedCommand}" Content="Run" />
                    <Button AutomationProperties.AutomationId="BulkEnableButton" Command="{x:Bind ViewModel.EnableSelectedCommand}" Content="Enable" />
                    <Button AutomationProperties.AutomationId="BulkDisableButton" Command="{x:Bind ViewModel.DisableSelectedCommand}" Content="Disable" />
                    <Button AutomationProperties.AutomationId="BulkMoveButton" Click="BulkMove_Click" Content="Move&#x2026;" />
                    <Button AutomationProperties.AutomationId="BulkDeleteButton" Click="BulkDelete_Click" Content="Delete" />
                </StackPanel>
            </Grid>

            <InfoBar
                Grid.Row="2"
                AutomationProperties.AutomationId="StatusInfoBar"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind helpers:Format.Severity(ViewModel.HasError), Mode=OneWay}" />

            <!--  Task table  -->
            <Border
                Grid.Row="3"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ProgressBar
                        Grid.Row="0"
                        VerticalAlignment="Top"
                        IsIndeterminate="True"
                        Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.IsBusy), Mode=OneWay}" />

                    <!--  Column headers  -->
                    <Grid
                        Grid.Row="0"
                        Padding="16,12"
                        ColumnSpacing="12"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="1.8*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" AutomationProperties.AutomationId="SortByNameHeader" AutomationProperties.Name="Sort by name" Padding="0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Name">
                            <TextBlock Text="{x:Bind ViewModel.HeaderName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </Button>
                        <Button Grid.Column="1" AutomationProperties.AutomationId="SortByStatusHeader" AutomationProperties.Name="Sort by status" Padding="0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="Status">
                            <TextBlock Text="{x:Bind ViewModel.HeaderStatus, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </Button>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Triggers" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Button Grid.Column="3" AutomationProperties.AutomationId="SortByNextRunHeader" AutomationProperties.Name="Sort by next run" Padding="0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="NextRun">
                            <TextBlock Text="{x:Bind ViewModel.HeaderNextRun, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </Button>
                        <Button Grid.Column="4" AutomationProperties.AutomationId="SortByLastRunHeader" AutomationProperties.Name="Sort by last run" Padding="0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.SortCommand}" CommandParameter="LastRun">
                            <TextBlock Text="{x:Bind ViewModel.HeaderLastRun, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </Button>
                    </Grid>

                    <ListView
                        x:Name="TaskListView"
                        Grid.Row="1"
                        AutomationProperties.AutomationId="TaskList"
                        ItemsSource="{x:Bind ViewModel.Tasks}"
                        SelectedItem="{x:Bind ViewModel.SelectedTask, Mode=TwoWay}"
                        SelectionChanged="TaskList_SelectionChanged"
                        RightTapped="TaskList_RightTapped"
                        SelectionMode="Extended">
                        <ListView.ContextFlyout>
                            <MenuFlyout x:Name="TaskContextMenu">
                                <MenuFlyoutItem Command="{x:Bind ViewModel.RunCommand}" Text="Run now">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE768;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.StopCommand}" Text="End">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE71A;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ToggleEnabledCommand}" Text="{x:Bind ViewModel.EnableToggleLabel, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="{x:Bind ViewModel.EnableToggleGlyph, Mode=OneWay}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="PinQuickLaunch_Click" Text="Pin to Quick Launch">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE945;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="Edit_Click" Text="Edit&#x2026;">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="EditInDesigner_Click" Text="Open in designer&#x2026;">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE9D9;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="Duplicate_Click" Text="Duplicate">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="Move_Click" Text="Move to folder&#x2026;">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8DE;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="Export_Click" Text="Export to XML&#x2026;">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEDE1;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="Delete_Click" Text="Delete">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="16,8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:TaskSummaryDto">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.5*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Name}">
                                        <TextBlock Text="{x:Bind Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{x:Bind helpers:Format.NotEmptyOrDash(Author)}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                        <FontIcon FontSize="14" Glyph="{x:Bind helpers:Format.StateGlyph(State)}" Foreground="{x:Bind helpers:Format.StateBrush(State)}" />
                                        <TextBlock Text="{x:Bind StateText}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind helpers:Format.NotEmptyOrDash(TriggersSummary)}"
                                        ToolTipService.ToolTip="{x:Bind helpers:Format.NotEmptyOrDash(TriggersSummary)}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind helpers:Format.DateText(NextRunTime)}" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{x:Bind helpers:Format.DateText(LastRunTime)}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <sizers:GridSplitter
                Grid.Row="4"
                Height="16"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="DetailSplitter"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Rows"
                ToolTipService.ToolTip="Drag to resize the details pane"
                Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.HasDetail), Mode=OneWay}" />

            <!--  Detail pane  -->
            <Border
                Grid.Row="5"
                MinHeight="240"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.HasDetail), Mode=OneWay}">
                <Grid Padding="16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Detail header + actions  -->
                    <Grid Grid.Row="0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Detail.Name, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Detail.Path, Mode=OneWay}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.AutomationId="RunButton" AutomationProperties.Name="Run now" Command="{x:Bind ViewModel.RunCommand}" ToolTipService.ToolTip="Run now">
                                <FontIcon FontSize="14" Glyph="&#xE768;" />
                            </Button>
                            <Button AutomationProperties.AutomationId="StopButton" AutomationProperties.Name="End" Command="{x:Bind ViewModel.StopCommand}" ToolTipService.ToolTip="End">
                                <FontIcon FontSize="14" Glyph="&#xE71A;" />
                            </Button>
                            <Button AutomationProperties.AutomationId="ToggleEnabledButton" Command="{x:Bind ViewModel.ToggleEnabledCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.EnableToggleGlyph, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.EnableToggleLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.AutomationId="EditButton" Click="Edit_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                    <TextBlock Text="Edit" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.AutomationId="DesignButton" AutomationProperties.Name="Open in the visual designer" Click="EditInDesigner_Click" ToolTipService.ToolTip="Open in the visual designer">
                                <FontIcon FontSize="14" Glyph="&#xE9D9;" />
                            </Button>
                            <Button AutomationProperties.AutomationId="DuplicateButton" AutomationProperties.Name="Duplicate" Click="Duplicate_Click" ToolTipService.ToolTip="Duplicate">
                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                            </Button>
                            <Button AutomationProperties.AutomationId="MoveButton" AutomationProperties.Name="Move to folder" Click="Move_Click" ToolTipService.ToolTip="Move to folder">
                                <FontIcon FontSize="14" Glyph="&#xE8DE;" />
                            </Button>
                            <Button AutomationProperties.AutomationId="ExportButton" AutomationProperties.Name="Export to XML" Click="Export_Click" ToolTipService.ToolTip="Export to XML">
                                <FontIcon FontSize="14" Glyph="&#xEDE1;" />
                            </Button>
                            <Button AutomationProperties.AutomationId="DeleteButton" AutomationProperties.Name="Delete" Click="Delete_Click" ToolTipService.ToolTip="Delete">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!--  Detail body  -->
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="24" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Last run" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind helpers:Format.DateText(ViewModel.Detail.LastRunTime), Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Text="Next run" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind helpers:Format.DateText(ViewModel.Detail.NextRunTime), Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Last result" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Detail.LastResultText, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Text="Author" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind helpers:Format.NotEmptyOrDash(ViewModel.Detail.Author), Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="Run as" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind helpers:Format.NotEmptyOrDash(ViewModel.Detail.Principal.UserId), Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Text="Missed runs" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Detail.MissedRuns, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                    <TextBlock Text="Description" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind helpers:Format.NotEmptyOrDash(ViewModel.Detail.Description), Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Triggers" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Detail.Triggers, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:TriggerDto">
                                        <Grid Margin="0,2" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" VerticalAlignment="Top" FontSize="14" Glyph="&#xE823;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Actions" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Detail.Actions, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:ActionDto">
                                        <Grid Margin="0,2" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" VerticalAlignment="Top" FontSize="14" Glyph="&#xE756;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Summary}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Expander HorizontalAlignment="Stretch" Header="Task XML">
                                <StackPanel Spacing="8">
                                    <Button AutomationProperties.AutomationId="CopyXmlButton" Click="CopyXml_Click" Content="Copy XML" />
                                    <TextBox
                                        AutomationProperties.AutomationId="DetailXmlBox"
                                        MinHeight="260"
                                        FontFamily="Consolas"
                                        IsReadOnly="True"
                                        Text="{x:Bind ViewModel.Detail.Xml, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>

                            <Expander
                                AutomationProperties.AutomationId="HistoryExpander"
                                HorizontalAlignment="Stretch"
                                Expanding="History_Expanding"
                                Header="History">
                                <StackPanel Spacing="8">
                                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.HistoryLoading), Mode=OneWay}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.HistoryStatus, Mode=OneWay}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap" />
                                    <ItemsControl AutomationProperties.AutomationId="HistoryList" ItemsSource="{x:Bind ViewModel.History}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="core:TaskHistoryEntryDto">
                                                <Grid Padding="0,4" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind TimeText}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind EventId}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind Category}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
