<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Tasker_App.Views.AssistantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:Tasker_App.Controls"
    xmlns:helpers="using:Tasker_App.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Tasker_App.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Create with Copilot" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Describe a task in plain language. Copilot will ask for anything it needs, then create it in Windows Task Scheduler."
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0" VerticalAlignment="Bottom">
                    <ComboBox
                        MinWidth="240"
                        AutomationProperties.AutomationId="ModelCombo"
                        DisplayMemberPath="Name"
                        DropDownOpened="ModelCombo_DropDownOpened"
                        Header="Model"
                        ItemsSource="{x:Bind ViewModel.Models}"
                        SelectedItem="{x:Bind ViewModel.SelectedModelOption, Mode=TwoWay}" />
                    <ComboBox
                        MinWidth="150"
                        AutomationProperties.AutomationId="EffortCombo"
                        Header="Reasoning effort"
                        IsEnabled="{x:Bind ViewModel.CanPickEffort, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.ReasoningEfforts}"
                        SelectedItem="{x:Bind ViewModel.SelectedReasoningEffort, Mode=TwoWay}" />
                    <ProgressRing
                        Width="18"
                        Height="18"
                        Margin="0,0,0,6"
                        VerticalAlignment="Bottom"
                        IsActive="{x:Bind ViewModel.ModelsLoading, Mode=OneWay}"
                        Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.ModelsLoading), Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
            <Button
                AutomationProperties.AutomationId="McpSetupButton"
                Grid.Column="1"
                VerticalAlignment="Top"
                Click="McpSetupButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE943;" />
                    <TextBlock Text="MCP setup" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  Authentication  -->
        <Expander
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <Grid HorizontalAlignment="Stretch" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" FontSize="16" Glyph="&#xE77B;" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="GitHub authentication" VerticalAlignment="Center" />
                    <!--  Sign-in status pill (visible even when collapsed)  -->
                    <Border
                        Grid.Column="2"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                AutomationProperties.AutomationId="AuthStatusIcon"
                                FontSize="14"
                                Glyph="{x:Bind helpers:Format.AuthGlyph(ViewModel.AuthState), Mode=OneWay}"
                                Foreground="{x:Bind helpers:Format.AuthBrush(ViewModel.AuthState), Mode=OneWay}" />
                            <TextBlock
                                AutomationProperties.AutomationId="AuthStatusText"
                                Text="{x:Bind ViewModel.AuthStatusText, Mode=OneWay}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Expander.Header>
            <StackPanel Spacing="10">
                <TextBlock
                    Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <Button
                    AutomationProperties.AutomationId="SignInGitHubButton"
                    Command="{x:Bind ViewModel.SignInWithGitHubCommand}"
                    Style="{ThemeResource AccentButtonStyle}"
                    Visibility="{x:Bind helpers:Format.VisibleWhenSignedOut(ViewModel.AuthState), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE77B;" />
                        <TextBlock Text="Sign in with GitHub" />
                    </StackPanel>
                </Button>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind helpers:Format.VisibleWhenSignedIn(ViewModel.AuthState), Mode=OneWay}">
                    <Button
                        x:Name="SwitchAccountButton"
                        AutomationProperties.AutomationId="SwitchAccountButton"
                        Click="SwitchAccountButton_Click"
                        Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.HasMultipleAccounts), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE748;" />
                            <TextBlock Text="Switch account" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.AutomationId="SignOutButton"
                        Command="{x:Bind ViewModel.SignOutCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE77B;" />
                            <TextBlock Text="Sign out" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}">
                    Uses the GitHub CLI (gh) to sign in interactively; it reuses your existing
                    gh session if you have one, otherwise opens the GitHub web sign-in. A Copilot
                    subscription is required. Alternatively, paste a GitHub token with Copilot access:
                </TextBlock>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox
                        x:Name="TokenBox"
                        Grid.Column="0"
                        AutomationProperties.AutomationId="TokenBox"
                        PlaceholderText="ghp_&#x2026; (optional)" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.AutomationId="SaveTokenButton"
                        Click="SaveToken_Click"
                        Content="Save token" />
                    <Button
                        Grid.Column="2"
                        AutomationProperties.AutomationId="ClearTokenButton"
                        Command="{x:Bind ViewModel.ClearTokenCommand}"
                        Content="Remove" />
                </Grid>
            </StackPanel>
        </Expander>

        <!--  Transcript  -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ScrollViewer x:Name="TranscriptScroller" Padding="16">
                <ItemsControl AutomationProperties.AutomationId="Transcript" ItemsSource="{x:Bind ViewModel.Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessage">
                            <Border
                                MaxWidth="600"
                                Margin="0,4"
                                Padding="12,10"
                                HorizontalAlignment="{x:Bind helpers:Format.ChatAlignment(IsUser)}"
                                Background="{x:Bind helpers:Format.ChatBubbleBrush(Role)}"
                                CornerRadius="8">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="{x:Bind Author}"
                                        Foreground="{x:Bind helpers:Format.ChatTextBrush(Role)}"
                                        Opacity="0.8"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        helpers:MarkdownExtensions.MarkdownText="{x:Bind Text}"
                                        Foreground="{x:Bind helpers:Format.ChatTextBrush(Role)}"
                                        IsTextSelectionEnabled="True"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!--  Suggested prompts (wrap to multiple rows instead of overflowing)  -->
        <ItemsControl
            Grid.Row="3"
            Margin="0,0,0,4"
            AutomationProperties.AutomationId="Suggestions"
            ItemsSource="{x:Bind ViewModel.Suggestions}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AssistantSuggestion">
                    <Button Click="Suggestion_Click" AutomationProperties.Name="{x:Bind Label}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="{x:Bind Glyph}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind Label}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Input  -->
        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="InputBox"
                Grid.Column="0"
                AutomationProperties.AutomationId="AssistantInput"
                IsEnabled="{x:Bind helpers:Format.Not(ViewModel.IsBusy), Mode=OneWay}"
                KeyDown="InputBox_KeyDown"
                PlaceholderText="e.g. Run backup.cmd every weekday at 6pm"
                Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="1"
                AutomationProperties.AutomationId="AssistantSend"
                Command="{x:Bind ViewModel.SendCommand}"
                Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing
                        Width="16"
                        Height="16"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.IsBusy), Mode=OneWay}" />
                    <FontIcon
                        FontSize="14"
                        Glyph="&#xE724;"
                        Visibility="{x:Bind helpers:Format.InvertBoolToVisibility(ViewModel.IsBusy), Mode=OneWay}" />
                    <TextBlock Text="Send" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
