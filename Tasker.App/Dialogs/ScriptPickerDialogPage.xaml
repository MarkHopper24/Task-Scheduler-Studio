<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Tasker_App.Dialogs.ScriptPickerDialogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Tasker_App.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:Tasker_App.Services"
    mc:Ignorable="d">

    <Grid Width="560" Height="540" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Pick a ready-made script. It will be saved as a .ps1 and added as an action; set its schedule on the canvas."
            TextWrapping="Wrap" />

        <AutoSuggestBox
            Grid.Row="1"
            AutomationProperties.AutomationId="ScriptPickerSearch"
            PlaceholderText="Search scripts&#x2026;"
            QueryIcon="Find"
            TextChanged="Search_TextChanged" />

        <ListView
            Grid.Row="2"
            x:Name="ScriptList"
            AutomationProperties.AutomationId="ScriptPickerList"
            ItemsSource="{x:Bind ViewModel.Filtered}"
            SelectionChanged="ScriptList_SelectionChanged"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="svc:ScriptTemplate">
                    <Grid Padding="4,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            Margin="0,2,0,0"
                            FontSize="18"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="{x:Bind Glyph}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="2"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Description}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Border
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Padding="6,1"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="4"
                            Visibility="{x:Bind helpers:Format.BoolToVisibility(RequiresAdmin)}">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Admin" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
