<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Tasker_App.Dialogs.MoveToFolderDialogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Width="420" Spacing="12">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <ComboBox
            x:Name="FolderCombo"
            AutomationProperties.AutomationId="MoveDestinationCombo"
            Header="Destination folder"
            HorizontalAlignment="Stretch"
            IsEditable="True"
            PlaceholderText="\" />
        <InfoBar
            x:Name="ErrorBar"
            AutomationProperties.AutomationId="MoveErrorBar"
            IsClosable="False"
            IsOpen="False"
            Severity="Error" />
    </StackPanel>
</Page>
