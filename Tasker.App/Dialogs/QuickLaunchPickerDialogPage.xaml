<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Tasker_App.Dialogs.QuickLaunchPickerDialogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Tasker_App.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Tasker_App.ViewModels"
    mc:Ignorable="d">

    <Grid Width="520" Height="520" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Pick the enabled tasks you want one-click access to. Only enabled tasks are shown."
            TextWrapping="Wrap" />

        <AutoSuggestBox
            x:Name="FilterBox"
            Grid.Row="1"
            AutomationProperties.AutomationId="QuickLaunchFilter"
            PlaceholderText="Filter tasks&#x2026;"
            QueryIcon="Find"
            TextChanged="FilterBox_TextChanged" />

        <Grid Grid.Row="2">
            <ProgressRing
                x:Name="LoadingRing"
                Width="28"
                Height="28"
                IsActive="True" />
            <TextBlock
                x:Name="EmptyText"
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No enabled tasks found."
                Visibility="Collapsed" />
            <ListView
                x:Name="TaskListView"
                AutomationProperties.AutomationId="QuickLaunchPickerList"
                ItemsSource="{x:Bind FilteredTasks}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PinnableTask">
                        <CheckBox
                            MinWidth="0"
                            Margin="0,2"
                            IsChecked="{x:Bind IsPinned, Mode=TwoWay}">
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind Folder}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
