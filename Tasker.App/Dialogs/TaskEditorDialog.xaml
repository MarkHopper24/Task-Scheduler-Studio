<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Tasker_App.Dialogs.TaskEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Tasker_App.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Tasker_App.ViewModels"
    Title="{x:Bind ViewModel.Title}"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnSave"
    PrimaryButtonText="Save"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">860</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">1600</x:Double>
    </ContentDialog.Resources>

    <Grid x:Name="RootGrid" Width="760" Height="600" MinHeight="420" RowSpacing="12" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar x:Name="SectionBar" Grid.Row="0" SelectionChanged="SectionBar_SelectionChanged">
            <SelectorBarItem x:Name="TabGeneral" AutomationProperties.AutomationId="TabGeneral" Text="General" IsSelected="True" />
            <SelectorBarItem x:Name="TabTriggers" AutomationProperties.AutomationId="TabTriggers" Text="Triggers" />
            <SelectorBarItem x:Name="TabActions" AutomationProperties.AutomationId="TabActions" Text="Actions" />
            <SelectorBarItem x:Name="TabConditions" AutomationProperties.AutomationId="TabConditions" Text="Conditions" />
            <SelectorBarItem x:Name="TabAdvanced" AutomationProperties.AutomationId="TabAdvanced" Text="Advanced" />
        </SelectorBar>

        <InfoBar
            Grid.Row="1"
            IsClosable="False"
            IsOpen="{x:Bind helpers:Format.IsNotEmpty(ViewModel.ValidationMessage), Mode=OneWay}"
            Message="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
            Severity="Warning" />

        <Grid Grid.Row="2">

            <!--  General  -->
            <ScrollViewer x:Name="GeneralPanel">
                <StackPanel Spacing="12">
                    <TextBox
                        AutomationProperties.AutomationId="EditorName"
                        Header="Name"
                        PlaceholderText="My task"
                        Text="{x:Bind ViewModel.TaskName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox
                        AutomationProperties.AutomationId="EditorFolder"
                        Header="Folder"
                        HorizontalAlignment="Stretch"
                        IsEditable="True"
                        ItemsSource="{x:Bind ViewModel.AvailableFolders}"
                        PlaceholderText="\"
                        Text="{x:Bind ViewModel.Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        AutomationProperties.AutomationId="EditorAuthor"
                        Header="Author"
                        Text="{x:Bind ViewModel.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        AutomationProperties.AutomationId="EditorDescription"
                        Header="Description"
                        AcceptsReturn="True"
                        Height="80"
                        TextWrapping="Wrap"
                        Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ToggleSwitch
                        AutomationProperties.AutomationId="EditorEnabled"
                        Header="Enabled"
                        IsOn="{x:Bind ViewModel.TaskEnabled, Mode=TwoWay}" />
                    <ToggleSwitch
                        AutomationProperties.AutomationId="EditorHighest"
                        Header="Run with highest privileges (requires admin)"
                        IsOn="{x:Bind ViewModel.RunWithHighestPrivileges, Mode=TwoWay}" />
                    <ToggleSwitch
                        AutomationProperties.AutomationId="EditorHidden"
                        Header="Hidden"
                        IsOn="{x:Bind ViewModel.Hidden, Mode=TwoWay}" />

                    <TextBlock Margin="0,4,0,0" Text="Security options" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBox
                        AutomationProperties.AutomationId="EditorRunAsUser"
                        Header="Run as user"
                        Text="{x:Bind ViewModel.RunAsUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox
                        AutomationProperties.AutomationId="EditorLogon"
                        Header="When to run"
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ViewModel.LogonOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedLogon, Mode=TwoWay}" />
                    <PasswordBox
                        x:Name="EditorPasswordBox"
                        AutomationProperties.AutomationId="EditorPassword"
                        Header="Account password"
                        Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.ShowRunAsPassword), Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>

            <!--  Triggers  -->
            <ScrollViewer x:Name="TriggersPanel" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <Button AutomationProperties.AutomationId="AddTriggerButton" Command="{x:Bind ViewModel.AddTriggerCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="Add trigger" />
                        </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Triggers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TriggerEditViewModel">
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="14"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox
                                                Grid.Column="0"
                                                Header="Type"
                                                HorizontalAlignment="Stretch"
                                                DisplayMemberPath="Label"
                                                ItemsSource="{x:Bind vm:TriggerEditViewModel.KindOptions}"
                                                SelectedItem="{x:Bind SelectedKindOption, Mode=TwoWay}" />
                                            <ToggleSwitch
                                                Grid.Column="1"
                                                VerticalAlignment="Bottom"
                                                Header="Enabled"
                                                IsOn="{x:Bind Enabled, Mode=TwoWay}" />
                                            <Button
                                                Grid.Column="2"
                                                VerticalAlignment="Bottom"
                                                Click="RemoveTrigger_Click"
                                                ToolTipService.ToolTip="Remove trigger">
                                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                            </Button>
                                        </Grid>

                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="12"
                                            Visibility="{x:Bind helpers:Format.BoolToVisibility(ShowStart), Mode=OneWay}">
                                            <CalendarDatePicker Header="Start date" Date="{x:Bind StartDate, Mode=TwoWay}" />
                                            <TimePicker Header="Start time" Time="{x:Bind StartTime, Mode=TwoWay}" />
                                        </StackPanel>

                                        <NumberBox
                                            Header="Recur every (days)"
                                            Minimum="1"
                                            SpinButtonPlacementMode="Inline"
                                            Value="{x:Bind DaysInterval, Mode=TwoWay}"
                                            Visibility="{x:Bind helpers:Format.BoolToVisibility(ShowDaily), Mode=OneWay}" />

                                        <NumberBox
                                            Header="Recur every (weeks)"
                                            Minimum="1"
                                            SpinButtonPlacementMode="Inline"
                                            Value="{x:Bind WeeksInterval, Mode=TwoWay}"
                                            Visibility="{x:Bind helpers:Format.BoolToVisibility(ShowWeekly), Mode=OneWay}" />

                                        <StackPanel Spacing="4" Visibility="{x:Bind helpers:Format.BoolToVisibility(ShowWeekdays), Mode=OneWay}">
                                            <TextBlock Text="Days of week" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <CheckBox MinWidth="0" Content="Mon" IsChecked="{x:Bind Monday, Mode=TwoWay}" />
                                                <CheckBox MinWidth="0" Content="Tue" IsChecked="{x:Bind Tuesday, Mode=TwoWay}" />
                                                <CheckBox MinWidth="0" Content="Wed" IsChecked="{x:Bind Wednesday, Mode=TwoWay}" />
                                                <CheckBox MinWidth="0" Content="Thu" IsChecked="{x:Bind Thursday, Mode=TwoWay}" />
                                                <CheckBox MinWidth="0" Content="Fri" IsChecked="{x:Bind Friday, Mode=TwoWay}" />
                                                <CheckBox MinWidth="0" Content="Sat" IsChecked="{x:Bind Saturday, Mode=TwoWay}" />
                                                <CheckBox MinWidth="0" Content="Sun" IsChecked="{x:Bind Sunday, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Spacing="4" Visibility="{x:Bind helpers:Format.BoolToVisibility(ShowMonthlyDow), Mode=OneWay}">
                                            <TextBlock Text="Weeks of month" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <CheckBox MinWidth="0" Content="1st" IsChecked="{x:Bind WeekFirst, Mode=TwoWay}" />
                                                <CheckBox MinWidth="0" Content="2nd" IsChecked="{x:Bind WeekSecond, Mode=TwoWay}" />
                                                <CheckBox MinWidth="0" Content="3rd" IsChecked="{x:Bind WeekThird, Mode=TwoWay}" />
                                                <CheckBox MinWidth="0" Content="4th" IsChecked="{x:Bind WeekFourth, Mode=TwoWay}" />
                                                <CheckBox MinWidth="0" Content="Last" IsChecked="{x:Bind WeekLast, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Spacing="4" Visibility="{x:Bind helpers:Format.BoolToVisibility(ShowMonthly), Mode=OneWay}">
                                            <TextBox
                                                Header="Days of month (comma-separated, e.g. 1,15)"
                                                Text="{x:Bind DaysOfMonthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Content="Run on the last day of the month" IsChecked="{x:Bind RunOnLastDayOfMonth, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Spacing="4" Visibility="{x:Bind helpers:Format.BoolToVisibility(ShowMonths), Mode=OneWay}">
                                            <TextBlock Text="Months" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <CheckBox MinWidth="0" Content="Jan" IsChecked="{x:Bind Jan, Mode=TwoWay}" />
                                                <CheckBox MinWidth="0" Content="Feb" IsChecked="{x:Bind Feb, Mode=TwoWay}" />
                                                <CheckBox MinWidth="0" Content="Mar" IsChecked="{x:Bind Mar, Mode=TwoWay}" />
                                                <CheckBox MinWidth="0" Content="Apr" IsChecked="{x:Bind Apr, Mode=TwoWay}" />
                                                <CheckBox MinWidth="0" Content="May" IsChecked="{x:Bind MayMonth, Mode=TwoWay}" />
                                                <CheckBox MinWidth="0" Content="Jun" IsChecked="{x:Bind Jun, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <CheckBox MinWidth="0" Content="Jul" IsChecked="{x:Bind Jul, Mode=TwoWay}" />
                                                <CheckBox MinWidth="0" Content="Aug" IsChecked="{x:Bind Aug, Mode=TwoWay}" />
                                                <CheckBox MinWidth="0" Content="Sep" IsChecked="{x:Bind Sep, Mode=TwoWay}" />
                                                <CheckBox MinWidth="0" Content="Oct" IsChecked="{x:Bind Oct, Mode=TwoWay}" />
                                                <CheckBox MinWidth="0" Content="Nov" IsChecked="{x:Bind Nov, Mode=TwoWay}" />
                                                <CheckBox MinWidth="0" Content="Dec" IsChecked="{x:Bind Dec, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <NumberBox
                                            Header="Delay (minutes)"
                                            Minimum="0"
                                            SpinButtonPlacementMode="Inline"
                                            Value="{x:Bind DelayMinutes, Mode=TwoWay}"
                                            Visibility="{x:Bind helpers:Format.BoolToVisibility(ShowDelay), Mode=OneWay}" />

                                        <TextBox
                                            Header="Specific user (optional)"
                                            Text="{x:Bind LogonUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{x:Bind helpers:Format.BoolToVisibility(ShowLogonUser), Mode=OneWay}" />

                                        <ComboBox
                                            Header="Session change"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{x:Bind vm:TriggerEditViewModel.SessionStates}"
                                            SelectedItem="{x:Bind StateChange, Mode=TwoWay}"
                                            Visibility="{x:Bind helpers:Format.BoolToVisibility(ShowSession), Mode=OneWay}" />

                                        <TextBox
                                            Header="Event subscription (XPath query XML)"
                                            AcceptsReturn="True"
                                            Height="80"
                                            FontFamily="Consolas"
                                            TextWrapping="Wrap"
                                            Text="{x:Bind Subscription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{x:Bind helpers:Format.BoolToVisibility(ShowEvent), Mode=OneWay}" />

                                        <StackPanel Spacing="8" Visibility="{x:Bind helpers:Format.BoolToVisibility(ShowRepeatExpiry), Mode=OneWay}">
                                            <CheckBox Content="Repeat the task" IsChecked="{x:Bind RepeatEnabled, Mode=TwoWay}" />
                                            <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind helpers:Format.BoolToVisibility(RepeatEnabled), Mode=OneWay}">
                                                <NumberBox Header="Every (minutes)" Minimum="1" SpinButtonPlacementMode="Inline" Value="{x:Bind RepeatEveryMinutes, Mode=TwoWay}" />
                                                <NumberBox Header="For (minutes, 0 = indefinitely)" Minimum="0" SpinButtonPlacementMode="Inline" Value="{x:Bind RepeatForMinutes, Mode=TwoWay}" />
                                            </StackPanel>
                                            <CheckBox Content="Expire on a date" IsChecked="{x:Bind ExpiresEnabled, Mode=TwoWay}" />
                                            <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind helpers:Format.BoolToVisibility(ExpiresEnabled), Mode=OneWay}">
                                                <CalendarDatePicker Header="Expiry date" Date="{x:Bind ExpireDate, Mode=TwoWay}" />
                                                <TimePicker Header="Expiry time" Time="{x:Bind ExpireTime, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!--  Actions  -->
            <ScrollViewer x:Name="ActionsPanel" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <Button AutomationProperties.AutomationId="AddActionButton" Command="{x:Bind ViewModel.AddActionCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="Add action" />
                        </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Actions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActionEditViewModel">
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="14"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                Grid.Column="0"
                                                Header="Program / script"
                                                PlaceholderText="C:\Windows\System32\cmd.exe"
                                                Text="{x:Bind Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button
                                                Grid.Column="1"
                                                VerticalAlignment="Bottom"
                                                Click="BrowseCommand_Click"
                                                Content="Browse&#x2026;" />
                                            <Button
                                                Grid.Column="2"
                                                VerticalAlignment="Bottom"
                                                Click="RemoveAction_Click"
                                                ToolTipService.ToolTip="Remove action">
                                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                            </Button>
                                        </Grid>
                                        <TextBox Header="Arguments (optional)" Text="{x:Bind Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Header="Start in / working directory (optional)" Text="{x:Bind WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!--  Conditions  -->
            <ScrollViewer x:Name="ConditionsPanel" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <ToggleSwitch Header="Allow task to be run on demand" IsOn="{x:Bind ViewModel.AllowDemandStart, Mode=TwoWay}" />
                    <ToggleSwitch Header="Run as soon as possible after a missed start" IsOn="{x:Bind ViewModel.StartWhenAvailable, Mode=TwoWay}" />
                    <ToggleSwitch Header="Start only if a network connection is available" IsOn="{x:Bind ViewModel.RunOnlyIfNetworkAvailable, Mode=TwoWay}" />
                    <ToggleSwitch Header="Start only if the computer is on AC power" IsOn="{x:Bind ViewModel.DisallowStartIfOnBatteries, Mode=TwoWay}" />
                    <ToggleSwitch Header="Stop if the computer switches to battery power" IsOn="{x:Bind ViewModel.StopIfGoingOnBatteries, Mode=TwoWay}" />
                    <ToggleSwitch Header="Wake the computer to run this task" IsOn="{x:Bind ViewModel.WakeToRun, Mode=TwoWay}" />
                    <ToggleSwitch Header="Start only if the computer is idle" IsOn="{x:Bind ViewModel.RunOnlyIfIdle, Mode=TwoWay}" />
                    <ToggleSwitch Header="Restart the task if it fails" IsOn="{x:Bind ViewModel.RestartOnFailure, Mode=TwoWay}" />
                    <NumberBox
                        Header="Number of restart attempts"
                        Minimum="0"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.RestartCount, Mode=TwoWay}" />
                    <ComboBox
                        Header="Stop the task if it runs longer than"
                        DisplayMemberPath="Label"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.TimeLimitOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedTimeLimit, Mode=TwoWay}" />
                    <ComboBox
                        Header="If the task is already running, then the following rule applies"
                        DisplayMemberPath="Label"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.InstancesOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedInstances, Mode=TwoWay}" />
                </StackPanel>
            </ScrollViewer>

            <!--  Advanced (raw XML)  -->
            <ScrollViewer x:Name="AdvancedPanel" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="EditorUseRawXml"
                        Header="Use raw XML instead of the fields above"
                        IsOn="{x:Bind ViewModel.UseRawXml, Mode=TwoWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        Text="Paste or edit a full Task Scheduler task definition. When the switch above is on, this XML is registered verbatim, giving full fidelity for trigger or action types the form does not cover." />
                    <TextBox
                        AutomationProperties.AutomationId="EditorXml"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        Height="420"
                        IsSpellCheckEnabled="False"
                        Text="{x:Bind ViewModel.Xml, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="NoWrap"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentDialog>
