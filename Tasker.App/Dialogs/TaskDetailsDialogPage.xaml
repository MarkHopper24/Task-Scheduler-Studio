<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Tasker_App.Dialogs.TaskDetailsDialogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Tasker_App.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Width="560" Height="560" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            Grid.Row="0"
            AutomationProperties.AutomationId="DetailsValidation"
            IsClosable="False"
            IsOpen="{x:Bind helpers:Format.IsNotEmpty(ViewModel.ValidationMessage), Mode=OneWay}"
            Message="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
            Severity="Warning" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12" Padding="0,0,14,0">
                <TextBox
                    AutomationProperties.AutomationId="DetailsName"
                    Header="Name"
                    PlaceholderText="My task"
                    Text="{x:Bind ViewModel.TaskName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox
                    AutomationProperties.AutomationId="DetailsFolder"
                    Header="Folder"
                    HorizontalAlignment="Stretch"
                    IsEditable="True"
                    ItemsSource="{x:Bind ViewModel.AvailableFolders}"
                    PlaceholderText="\"
                    Text="{x:Bind ViewModel.Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Header="Author"
                    Text="{x:Bind ViewModel.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    AcceptsReturn="True"
                    Header="Description"
                    Height="72"
                    TextWrapping="Wrap"
                    Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ToggleSwitch Header="Enabled" IsOn="{x:Bind ViewModel.TaskEnabled, Mode=TwoWay}" />
                <ToggleSwitch Header="Run with highest privileges (requires admin)" IsOn="{x:Bind ViewModel.RunWithHighestPrivileges, Mode=TwoWay}" />
                <ToggleSwitch Header="Hidden" IsOn="{x:Bind ViewModel.Hidden, Mode=TwoWay}" />

                <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Run as" />
                <TextBox
                    Header="Run as user"
                    Text="{x:Bind ViewModel.RunAsUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox
                    DisplayMemberPath="Label"
                    Header="When to run"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.LogonOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedLogon, Mode=TwoWay}" />
                <PasswordBox
                    x:Name="DetailsPasswordBox"
                    AutomationProperties.AutomationId="DetailsPassword"
                    Header="Account password"
                    PasswordChanged="Password_Changed"
                    Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.ShowRunAsPassword), Mode=OneWay}" />

                <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Advanced" />
                <ToggleSwitch
                    AutomationProperties.AutomationId="DetailsUseRawXml"
                    Header="Use raw XML instead of the fields above"
                    IsOn="{x:Bind ViewModel.UseRawXml, Mode=TwoWay}" />
                <TextBox
                    AutomationProperties.AutomationId="DetailsXml"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    Height="180"
                    IsSpellCheckEnabled="False"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{x:Bind ViewModel.Xml, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="NoWrap"
                    Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.UseRawXml), Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
