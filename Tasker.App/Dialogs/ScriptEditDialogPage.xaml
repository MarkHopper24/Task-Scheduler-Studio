<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Tasker_App.Dialogs.ScriptEditDialogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Width="620" Height="600" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            Grid.Row="0"
            x:Name="ValidationBar"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12" Padding="0,0,14,0">
                <TextBox
                    x:Name="TitleBox"
                    AutomationProperties.AutomationId="ScriptEditTitle"
                    Header="Title"
                    PlaceholderText="My script" />
                <TextBox
                    x:Name="DescriptionBox"
                    AcceptsReturn="True"
                    Header="Description"
                    Height="60"
                    TextWrapping="Wrap" />
                <ComboBox
                    x:Name="CategoryCombo"
                    Header="Category"
                    HorizontalAlignment="Stretch">
                    <x:String>Cleanup</x:String>
                    <x:String>Backup</x:String>
                    <x:String>Maintenance</x:String>
                    <x:String>Monitoring</x:String>
                    <x:String>System</x:String>
                </ComboBox>
                <ToggleSwitch x:Name="AdminToggle" Header="Needs administrator (run with highest privileges)" />
                <ToggleSwitch x:Name="BackgroundToggle" Header="Run hidden in the background" IsOn="True" />
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Script (PowerShell)" />
                    <TextBox
                        x:Name="BodyBox"
                        AutomationProperties.AutomationId="ScriptEditBody"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        Height="300"
                        IsSpellCheckEnabled="False"
                        PlaceholderText="# Your PowerShell here"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="NoWrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
