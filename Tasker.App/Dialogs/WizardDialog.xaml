<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Tasker_App.Dialogs.WizardDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Tasker_App.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:Tasker_App.Services"
    Title="Guided setup"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimary"
    SecondaryButtonClick="OnSecondary"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>
    </ContentDialog.Resources>

    <Grid Width="780" Height="560" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Step indicator  -->
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock
                x:Name="StepLabel"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Step 1 of 4" />
            <ProgressBar x:Name="StepProgress" Maximum="4" Minimum="1" Value="1" />
        </StackPanel>

        <Grid Grid.Row="1">

            <!--  Step 1: choose a recipe  -->
            <ScrollViewer x:Name="StepChoose">
                <StackPanel Spacing="12">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="What would you like to schedule? Pick a starting point &#x2014; we'll guide you through the rest, no command line needed."
                        TextWrapping="Wrap" />
                    <GridView
                        x:Name="RecipeGrid"
                        AutomationProperties.AutomationId="RecipeGrid"
                        IsItemClickEnabled="True"
                        ItemClick="Recipe_ItemClick"
                        ItemsSource="{x:Bind ViewModel.Recipes}"
                        SelectionMode="Single">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="svc:TaskRecipe">
                                <Grid
                                    Width="232"
                                    Height="150"
                                    Padding="14"
                                    ColumnSpacing="12"
                                    ToolTipService.ToolTip="{x:Bind Description}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        VerticalAlignment="Top"
                                        FontSize="24"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="{x:Bind Glyph}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" MaxLines="2" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{x:Bind Description}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="4"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </ScrollViewer>

            <!--  Step 2: details (dynamic fields rendered in code-behind)  -->
            <ScrollViewer x:Name="StepDetails" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon x:Name="DetailGlyph" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="DetailTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="DetailDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="FieldsPanel" Spacing="14" />
                </StackPanel>
            </ScrollViewer>

            <!--  Step 3: schedule  -->
            <ScrollViewer x:Name="StepSchedule" Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <TextBlock Text="When should this run?" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox
                        AutomationProperties.AutomationId="WizScheduleCombo"
                        Header="Schedule"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.ScheduleOptions}"
                        SelectedIndex="{x:Bind ViewModel.ScheduleIndex, Mode=TwoWay}" />

                    <TimePicker
                        AutomationProperties.AutomationId="WizTime"
                        Header="Time"
                        Time="{x:Bind ViewModel.StartTime, Mode=TwoWay}"
                        Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.ShowTime), Mode=OneWay}" />

                    <CalendarDatePicker
                        Header="Date"
                        Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}"
                        Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.ShowDate), Mode=OneWay}" />

                    <StackPanel Spacing="6" Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.ShowWeekdays), Mode=OneWay}">
                        <TextBlock Text="Days of the week" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox MinWidth="0" Content="Mon" IsChecked="{x:Bind ViewModel.Mon, Mode=TwoWay}" />
                            <CheckBox MinWidth="0" Content="Tue" IsChecked="{x:Bind ViewModel.Tue, Mode=TwoWay}" />
                            <CheckBox MinWidth="0" Content="Wed" IsChecked="{x:Bind ViewModel.Wed, Mode=TwoWay}" />
                            <CheckBox MinWidth="0" Content="Thu" IsChecked="{x:Bind ViewModel.Thu, Mode=TwoWay}" />
                            <CheckBox MinWidth="0" Content="Fri" IsChecked="{x:Bind ViewModel.Fri, Mode=TwoWay}" />
                            <CheckBox MinWidth="0" Content="Sat" IsChecked="{x:Bind ViewModel.Sat, Mode=TwoWay}" />
                            <CheckBox MinWidth="0" Content="Sun" IsChecked="{x:Bind ViewModel.Sun, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!--  Step 4: review  -->
            <ScrollViewer x:Name="StepReview" Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <TextBlock Text="Review and create" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="16" Glyph="&#xE9D9;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="What it does" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="ReviewWhat" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                <FontIcon FontSize="16" Glyph="&#xE823;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="When it runs" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.ScheduleSummary, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <InfoBar
                        x:Name="ReviewWarning"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Warning" />

                    <TextBox
                        AutomationProperties.AutomationId="WizName"
                        Header="Task name"
                        Text="{x:Bind ViewModel.TaskName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox
                        x:Name="WizFolder"
                        AutomationProperties.AutomationId="WizFolder"
                        Header="Save in folder"
                        HorizontalAlignment="Stretch"
                        IsEditable="True"
                        Text="{x:Bind ViewModel.Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <InfoBar
                        x:Name="WizError"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Error" />

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        Text="Tip: after it's created you can fine-tune anything in the full editor (Edit), or see the exact command under Task XML." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentDialog>
