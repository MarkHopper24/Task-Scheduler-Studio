<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Tasker_App.Controls.TriggerEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Tasker_App.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Tasker_App.ViewModels"
    mc:Ignorable="d">

    <StackPanel Spacing="10">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                Grid.Column="0"
                Header="Type"
                HorizontalAlignment="Stretch"
                DisplayMemberPath="Label"
                ItemsSource="{x:Bind vm:TriggerEditViewModel.KindOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedKindOption, Mode=TwoWay}" />
            <ToggleSwitch
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Header="Enabled"
                IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}" />
            <Button
                Grid.Column="2"
                VerticalAlignment="Bottom"
                Click="Remove_Click"
                ToolTipService.ToolTip="Remove trigger"
                Visibility="{x:Bind helpers:Format.BoolToVisibility(ShowRemoveButton), Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xE74D;" />
            </Button>
        </Grid>

        <StackPanel
            Orientation="Horizontal"
            Spacing="12"
            Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.ShowStart), Mode=OneWay}">
            <CalendarDatePicker Header="Start date" Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}" />
            <TimePicker Header="Start time" Time="{x:Bind ViewModel.StartTime, Mode=TwoWay}" />
        </StackPanel>

        <NumberBox
            Header="Recur every (days)"
            Minimum="1"
            SpinButtonPlacementMode="Inline"
            Value="{x:Bind ViewModel.DaysInterval, Mode=TwoWay}"
            Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.ShowDaily), Mode=OneWay}" />

        <NumberBox
            Header="Recur every (weeks)"
            Minimum="1"
            SpinButtonPlacementMode="Inline"
            Value="{x:Bind ViewModel.WeeksInterval, Mode=TwoWay}"
            Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.ShowWeekly), Mode=OneWay}" />

        <StackPanel Spacing="4" Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.ShowWeekdays), Mode=OneWay}">
            <TextBlock Text="Days of week" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox MinWidth="0" Content="Mon" IsChecked="{x:Bind ViewModel.Monday, Mode=TwoWay}" />
                <CheckBox MinWidth="0" Content="Tue" IsChecked="{x:Bind ViewModel.Tuesday, Mode=TwoWay}" />
                <CheckBox MinWidth="0" Content="Wed" IsChecked="{x:Bind ViewModel.Wednesday, Mode=TwoWay}" />
                <CheckBox MinWidth="0" Content="Thu" IsChecked="{x:Bind ViewModel.Thursday, Mode=TwoWay}" />
                <CheckBox MinWidth="0" Content="Fri" IsChecked="{x:Bind ViewModel.Friday, Mode=TwoWay}" />
                <CheckBox MinWidth="0" Content="Sat" IsChecked="{x:Bind ViewModel.Saturday, Mode=TwoWay}" />
                <CheckBox MinWidth="0" Content="Sun" IsChecked="{x:Bind ViewModel.Sunday, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="4" Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.ShowMonthlyDow), Mode=OneWay}">
            <TextBlock Text="Weeks of month" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox MinWidth="0" Content="1st" IsChecked="{x:Bind ViewModel.WeekFirst, Mode=TwoWay}" />
                <CheckBox MinWidth="0" Content="2nd" IsChecked="{x:Bind ViewModel.WeekSecond, Mode=TwoWay}" />
                <CheckBox MinWidth="0" Content="3rd" IsChecked="{x:Bind ViewModel.WeekThird, Mode=TwoWay}" />
                <CheckBox MinWidth="0" Content="4th" IsChecked="{x:Bind ViewModel.WeekFourth, Mode=TwoWay}" />
                <CheckBox MinWidth="0" Content="Last" IsChecked="{x:Bind ViewModel.WeekLast, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="4" Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.ShowMonthly), Mode=OneWay}">
            <TextBox
                Header="Days of month (comma-separated, e.g. 1,15)"
                Text="{x:Bind ViewModel.DaysOfMonthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Content="Run on the last day of the month" IsChecked="{x:Bind ViewModel.RunOnLastDayOfMonth, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel Spacing="4" Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.ShowMonths), Mode=OneWay}">
            <TextBlock Text="Months" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <CheckBox MinWidth="0" Content="Jan" IsChecked="{x:Bind ViewModel.Jan, Mode=TwoWay}" />
                <CheckBox MinWidth="0" Content="Feb" IsChecked="{x:Bind ViewModel.Feb, Mode=TwoWay}" />
                <CheckBox MinWidth="0" Content="Mar" IsChecked="{x:Bind ViewModel.Mar, Mode=TwoWay}" />
                <CheckBox MinWidth="0" Content="Apr" IsChecked="{x:Bind ViewModel.Apr, Mode=TwoWay}" />
                <CheckBox MinWidth="0" Content="May" IsChecked="{x:Bind ViewModel.MayMonth, Mode=TwoWay}" />
                <CheckBox MinWidth="0" Content="Jun" IsChecked="{x:Bind ViewModel.Jun, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <CheckBox MinWidth="0" Content="Jul" IsChecked="{x:Bind ViewModel.Jul, Mode=TwoWay}" />
                <CheckBox MinWidth="0" Content="Aug" IsChecked="{x:Bind ViewModel.Aug, Mode=TwoWay}" />
                <CheckBox MinWidth="0" Content="Sep" IsChecked="{x:Bind ViewModel.Sep, Mode=TwoWay}" />
                <CheckBox MinWidth="0" Content="Oct" IsChecked="{x:Bind ViewModel.Oct, Mode=TwoWay}" />
                <CheckBox MinWidth="0" Content="Nov" IsChecked="{x:Bind ViewModel.Nov, Mode=TwoWay}" />
                <CheckBox MinWidth="0" Content="Dec" IsChecked="{x:Bind ViewModel.Dec, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>

        <NumberBox
            Header="Delay (minutes)"
            Minimum="0"
            SpinButtonPlacementMode="Inline"
            Value="{x:Bind ViewModel.DelayMinutes, Mode=TwoWay}"
            Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.ShowDelay), Mode=OneWay}" />

        <TextBox
            Header="Specific user (optional)"
            Text="{x:Bind ViewModel.LogonUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.ShowLogonUser), Mode=OneWay}" />

        <ComboBox
            Header="Session change"
            HorizontalAlignment="Stretch"
            ItemsSource="{x:Bind vm:TriggerEditViewModel.SessionStates}"
            SelectedItem="{x:Bind ViewModel.StateChange, Mode=TwoWay}"
            Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.ShowSession), Mode=OneWay}" />

        <TextBox
            Header="Event subscription (XPath query XML)"
            AcceptsReturn="True"
            Height="80"
            FontFamily="Consolas"
            TextWrapping="Wrap"
            Text="{x:Bind ViewModel.Subscription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.ShowEvent), Mode=OneWay}" />

        <StackPanel Spacing="8" Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.ShowRepeatExpiry), Mode=OneWay}">
            <CheckBox Content="Repeat the task" IsChecked="{x:Bind ViewModel.RepeatEnabled, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.RepeatEnabled), Mode=OneWay}">
                <NumberBox Header="Every (minutes)" Minimum="1" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.RepeatEveryMinutes, Mode=TwoWay}" />
                <NumberBox Header="For (minutes, 0 = indefinitely)" Minimum="0" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.RepeatForMinutes, Mode=TwoWay}" />
            </StackPanel>
            <CheckBox Content="Expire on a date" IsChecked="{x:Bind ViewModel.ExpiresEnabled, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind helpers:Format.BoolToVisibility(ViewModel.ExpiresEnabled), Mode=OneWay}">
                <CalendarDatePicker Header="Expiry date" Date="{x:Bind ViewModel.ExpireDate, Mode=TwoWay}" />
                <TimePicker Header="Expiry time" Time="{x:Bind ViewModel.ExpireTime, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
