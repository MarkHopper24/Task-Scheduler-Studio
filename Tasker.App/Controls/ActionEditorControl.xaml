<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Tasker_App.Controls.ActionEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Tasker_App.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="10">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                Header="Program / script"
                PlaceholderText="C:\Windows\System32\cmd.exe"
                Text="{x:Bind ViewModel.Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Click="Browse_Click"
                Content="Browse&#x2026;" />
            <Button
                Grid.Column="2"
                VerticalAlignment="Bottom"
                Click="Remove_Click"
                ToolTipService.ToolTip="Remove action"
                Visibility="{x:Bind helpers:Format.BoolToVisibility(ShowRemoveButton), Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xE74D;" />
            </Button>
        </Grid>
        <TextBox Header="Arguments (optional)" Text="{x:Bind ViewModel.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBox Header="Start in / working directory (optional)" Text="{x:Bind ViewModel.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
</UserControl>
